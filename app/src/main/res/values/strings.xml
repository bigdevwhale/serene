    <string name="breath_calm">Calming breath</string>
    <string name="breath_calm_text">Breathe in for four, out for six. Longer exhales tell the body it is safe to rest.</string>
    <string name="breath_box">Box breathing</string>
    <string name="breath_box_text">Four counts in, hold, out, hold. Steady and grounding when the mind races.</string>
    <string name="breath_relax">4-7-8 relax</string>
    <string name="breath_relax_text">In for four, hold for seven, out for eight. A classic for falling asleep.</string>
    <string name="breath_coherent">Coherent breathing</string>
    <string name="breath_coherent_text">About five breaths a minute, even in and out. Balancing and calm.</string>
    <string name="breath_sigh">Physiological sigh</string>
    <string name="breath_sigh_text">Two inhales through the nose, one long sigh out. The fastest way to let tension go.</string>
    <string name="breath_balance">Equal breathing</string>
    <string name="breath_balance_text">Four in, four out. Simple, even and centring.</string>
    <string name="phase_inhale">Breathe in</string>
    <string name="phase_top_up">A little more</string>
    <string name="phase_hold">Hold</string>
    <string name="phase_exhale">Breathe out</string>
    <string name="phase_rest">Rest</string>

